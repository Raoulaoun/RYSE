# Postgres connection string. On Railway, set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ryse

# Email (Brevo). Without a key, emails are printed to the server log instead of sent.
BREVO_API_KEY=
MAIL_FROM="Ryse <hello@ryseventure.com>"
# Public URL used in emailed links. On Railway this falls back to RAILWAY_PUBLIC_DOMAIN.
APP_URL=http://localhost:3000

# First admin, created on deploy if no admin with this email exists yet.
ADMIN_EMAIL=
ADMIN_NAME=

# The admin panel is off unless this is "true".
ADMIN_ENABLED=false
# Where new applications and partner messages are emailed.
NOTIFY_EMAIL=hello@ryseventure.com
# Signs the pitch-deck download links in those emails. Any long random string.
DECK_LINK_SECRET=
